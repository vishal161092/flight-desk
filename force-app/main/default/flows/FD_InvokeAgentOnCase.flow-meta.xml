<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <description>Record-triggered flow that invokes the ZephyrAir_ServiceAgent when a new Case is created from the Web (Experience Site). The agent reads the case description and handles all intents autonomously.</description>
    <environments>Default</environments>
    <interviewLabel>FD Invoke Agent On Case {!$Flow.CurrentDateTime}</interviewLabel>
    <label>FD Invoke Agent On Case</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value><stringValue>LightningFlowBuilder</stringValue></value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Origin</field>
            <operator>EqualTo</operator>
            <value><stringValue>Web</stringValue></value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
        <connector>
            <targetReference>Invoke_ZephyrAir_ServiceAgent</targetReference>
        </connector>
    </start>
    <actionCalls>
        <name>Invoke_ZephyrAir_ServiceAgent</name>
        <label>Invoke Zephyr Air Service Agent</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <actionName>ZephyrAir_ServiceAgent</actionName>
        <actionType>aiAgent</actionType>
        <inputParameters>
            <name>input</name>
            <value>
                <stringValue>Please review and resolve the customer case. Case ID: {!$Record.Id}. Subject: {!$Record.Subject}. Description: {!$Record.Description}. PNR Number: {!$Record.FD_PNRNumber__c}.</stringValue>
            </value>
        </inputParameters>
        <faultConnector>
            <targetReference>Log_Agent_Fault</targetReference>
        </faultConnector>
    </actionCalls>
    <recordUpdates>
        <name>Log_Agent_Fault</name>
        <label>Log Agent Invocation Fault</label>
        <locationX>396</locationX>
        <locationY>168</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value><elementReference>$Record.Id</elementReference></value>
        </filters>
        <inputAssignments>
            <field>FD_ResolutionSummary__c</field>
            <value><stringValue>Agent invocation failed. Please assign to a human agent for review.</stringValue></value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <status>Active</status>
</Flow>
